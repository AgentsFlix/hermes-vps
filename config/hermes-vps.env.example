# Configuração do harness. Copie para config/hermes-vps.env e preencha.
# Aqui NÃO vai senha nenhuma. A senha do painel entra por config/senha.local,
# que o harness cria, abre para você digitar e apaga depois de usar.

# IP ou hostname da VPS (na Hostinger: hPanel > VPS > Visão geral > IPv4)
VPS_HOST=

# Usuário SSH. Na Hostinger é root.
SSH_USER=root

# Porta SSH. Quase sempre 22.
SSH_PORT=22

# Chave SSH usada para entrar na VPS. Se o arquivo não existir, o preflight cria.
SSH_KEY=~/.ssh/hermes-vps

# Como o painel fica acessível:
#   publico  = endereço https na internet, com usuário e senha (igual ao EasyPanel de referência)
#   tunel    = só pela sua máquina, por túnel SSH; nada exposto na internet além do SSH
MODO=publico

# Opcional. Um domínio seu já apontando (registro A) para o IP da VPS.
# Vazio = o harness usa o hostname da própria VPS (srvNNN.hstgr.cloud na Hostinger).
DOMINIO=

# Usuário de login do painel (letras minúsculas, números, ponto, hífen).
PAINEL_USUARIO=admin
